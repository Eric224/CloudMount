+
+	"github.com/rclone/rclone/backend/drime/api"
+	"github.com/rclone/rclone/fs"
+	"github.com/rclone/rclone/lib/encoder"
+	"github.com/rclone/rclone/lib/pacer"
+	"github.com/rclone/rclone/lib/rest"
+)
+
+func TestCloudMountReplacementRequiresIndependentProof(t *testing.T) {
+	item := func(id, name string, size int64) api.Item {
+		return api.Item{ID: json.Number(id), Name: name, FileSize: size}
+	}
+	for _, tc := range []struct {
+		name   string
+		pages  [][]api.Item
+		status int
+		want   bool
+	}{
+		{"new visible old absent", [][]api.Item{{item("2", "file", 42)}}, 200, true},
+		{"old still visible", [][]api.Item{{item("1", "file", 30), item("2", "file", 42)}}, 200, false},
+		{"old on later page", [][]api.Item{{item("2", "file", 42)}, {item("1", "file", 30)}}, 200, false},
+		{"new on later page", [][]api.Item{{item("3", "other", 10)}, {item("2", "file", 42)}}, 200, true},
+		{"new missing", [][]api.Item{{}}, 200, false},
+		{"wrong size", [][]api.Item{{item("2", "file", 41)}}, 200, false},
+		{"wrong name", [][]api.Item{{item("2", "other", 42)}}, 200, false},
+		{"permission failure", nil, 403, false},
+		{"server failure", nil, 500, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				if tc.status != 200 {
+					w.WriteHeader(tc.status)
+					_, _ = w.Write([]byte(`{"message":"service failure"}`))
+					return
+				}
+				page := 1
+				if r.URL.Query().Get("page") == "2" {
+					page = 2
+				}
+				_ = json.NewEncoder(w).Encode(api.Listing{CurrentPage: page, LastPage: len(tc.pages), Data: tc.pages[page-1]})
+			}))
+			defer server.Close()
+			ctx, cancel := context.WithTimeout(context.Background(), 200*time.Millisecond)
+			defer cancel()
+			f := &Fs{srv: rest.NewClient(server.Client()).SetRoot(server.URL),
+				opt:   Options{ListChunk: 1000, Enc: encoder.Display},
+				pacer: fs.NewPacer(ctx, pacer.NewDefault(pacer.MinSleep(time.Millisecond), pacer.MaxSleep(time.Millisecond)))}
+			f.srv.SetErrorHandler(errorHandler)
+			if got := f.confirmReplacement(ctx, "1", "2", "parent", "file", 42); got != tc.want {
+				t.Fatalf("confirmation = %v, want %v", got, tc.want)
+			}
+			if f.confirmReplacement(ctx, "2", "2", "parent", "file", 42) {
+				t.Fatal("same ID cannot prove absence")
+			}
+		})
+	}
+}
+
+func TestCloudMountLocalizedValidationRetainsHTTPStatus(t *testing.T) {
+	for _, message := range []string{"所選的 entry ids 無效。", "The selected entry ids is invalid.", "Ausgewählte Einträge sind ungültig."} {
+		response := &http.Response{StatusCode: 422, Body: http.NoBody}
+		body, _ := json.Marshal(map[string]string{"message": message})
+		response.Body = io.NopCloser(strings.NewReader(string(body)))
+		var serviceError api.Error
+		if !errors.As(errorHandler(response), &serviceError) || serviceError.StatusCode != 422 || serviceError.Message != message {
+			t.Fatal("localized status lost")
+		}
+	}

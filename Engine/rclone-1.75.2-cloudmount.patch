+// confirmReplacement fails closed on listing errors, missing/reused IDs, wrong
+// sizes, and old objects which still exist. It never deletes anything itself.
+func (f *Fs) confirmReplacement(ctx context.Context, oldID, newID, dirID, leaf string, size int64) bool {
+	if oldID == "" || newID == "" || oldID == newID || size < 0 {
+		return false
+	}
+	oldFound, newFound := false, false
+	_, err := f.listAll(ctx, dirID, false, true, "", func(item *api.Item) bool {
+		if item.ID.String() == oldID {
+			oldFound = true
+		}
+		if item.ID.String() == newID && item.Name == leaf && item.FileSize == size && item.IsDeleted == 0 && item.DeletedAt == nil {
+			newFound = true
+		}
+		return false // All pages are required to establish the old ID is absent.
+	})
+	return err == nil && !oldFound && newFound
+}
